# Copie para .env e preencha. Nunca versione valores reais.

# Obrigatória: gere um valor longo e aleatório (vazia, toda requisição falha).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Hosts aceitos, separados por vírgula. No Render, o hostname do serviço
# (RENDER_EXTERNAL_HOSTNAME) é incluído automaticamente.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens HTTPS extras confiáveis para CSRF (ex.: domínio próprio), separadas
# por vírgula. A origem https:// do Render é incluída automaticamente.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Credenciais do login da demonstração. Vazias, o login recusa todo acesso.
DEMO_LOGIN=
DEMO_PASSWORD=

# A Gemini API Key NÃO é configurada aqui: ela é informada na interface a cada
# processamento e não é armazenada.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=60
GEMINI_MAX_TENTATIVAS=3

# Tamanho máximo do PDF enviado, em MB.
MAX_PDF_UPLOAD_SIZE_MB=10

# Timeout do Gunicorn em segundos (start.sh). PORT e WEB_CONCURRENCY são
# definidos pelo Render; não configure PORT manualmente lá.
GUNICORN_TIMEOUT=420
