# Modelo de configuração para todos os desenvolvedores. Nunca versione valores reais.
# Como usar:
# 1. Copie para o seu .env privado as variáveis que ainda não estão nele.
# 2. Preserve as variáveis que já estão configuradas no seu .env.
# 3. Na seção de testes, preencha os dados do SEU PostgreSQL local.
# 4. Use as credenciais de homologação só quando autorizado e necessário.
# 5. Nunca compartilhe nem versione senhas; o .env não vai para o Git.

# Obrigatória: gere um valor longo e aleatório (vazia, toda requisição falha).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Hosts aceitos, separados por vírgula. No Render, o hostname do serviço
# (RENDER_EXTERNAL_HOSTNAME) é incluído automaticamente.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens HTTPS extras confiáveis para CSRF (ex.: domínio próprio), separadas
# por vírgula. A origem https:// do Render é incluída automaticamente.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Credenciais do login da demonstração. Vazias, o login recusa todo acesso.
DEMO_LOGIN=
DEMO_PASSWORD=

# A Gemini API Key NÃO é configurada aqui: ela é informada na interface a cada
# processamento e não é armazenada.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=60
GEMINI_MAX_TENTATIVAS=3

# Tamanho máximo do PDF enviado, em MB.
MAX_PDF_UPLOAD_SIZE_MB=10

# Timeout do Gunicorn em segundos (start.sh). PORT e WEB_CONCURRENCY são
# definidos pelo Render; não configure PORT manualmente lá.
GUNICORN_TIMEOUT=420

# ---------------------------------------------------------------------------
# PostgreSQL Supabase: homologação
# ---------------------------------------------------------------------------
# Conexão do Django (aplicação) com o banco de homologação no Supabase
# (ADR-001), acessado só pelo Django ORM. Peça os valores ao responsável; não
# use estas credenciais nos testes automatizados.
# Obrigatórias: DB_HOST, DB_NAME, DB_USER e DB_PASSWORD. Vazias, o Django não
# inicia (não há banco substituto). Use o Session Pooler do painel do Supabase
# (Connect > Session pooler), compatível com IPv4.
# Host do Session Pooler (ex.: aws-0-<regiao>.pooler.supabase.com).
DB_HOST=
# Porta do Session Pooler (modo session). Opcional; padrão 5432.
DB_PORT=5432
DB_NAME=postgres
# Usuário no formato do pooler: postgres.<referencia-do-projeto>.
DB_USER=
# Senha do banco definida no Supabase. Sem aspas.
DB_PASSWORD=

# Opcionais. Modo TLS: require (padrão), verify-ca ou verify-full; modos sem
# criptografia obrigatória são recusados. require criptografa, mas não valida
# o certificado do servidor.
# DB_SSLMODE=require
# Caminho do certificado da CA do Supabase (necessário para verify-ca e
# verify-full).
# DB_SSLROOTCERT=
# Tempo máximo para abrir a conexão, em segundos.
# DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# PostgreSQL local: testes automatizados
# ---------------------------------------------------------------------------
# PostgreSQL local exclusivo para testes automatizados (config/banco_de_teste.py).
# Cada desenvolvedor configura o próprio usuário e senha no .env.
# NUNCA use credenciais do Supabase nesta seção, nem banco de homologação ou
# produção para testes destrutivos.
# Os testes com banco (TestCase) criam e APAGAM automaticamente o banco
# descartável DB_TEST_NAME a cada execução. Sem estas variáveis, eles não rodam
# (não há banco substituto); os testes sem banco não dependem delas.
#
# Host exclusivamente local: 127.0.0.1 (TCP com senha), localhost, ::1 ou o
# diretório do socket Unix (ex.: /run/postgresql, que exige a autenticação
# local do PostgreSQL configurada, como peer). Hosts remotos são recusados.
DB_TEST_HOST=127.0.0.1
# Porta do PostgreSQL local; normalmente 5432.
DB_TEST_PORT=5432
# Banco descartável de testes; precisa começar com test_.
DB_TEST_NAME=test_gestao_rural
# Seu usuário PostgreSQL local, com permissão CREATEDB (sem superusuário).
DB_TEST_USER=
# Senha local desse usuário, quando o método de autenticação exigir (no TCP,
# normalmente sim; pelo socket com peer, deixe vazia).
DB_TEST_PASSWORD=
# Tempo máximo para abrir a conexão, em segundos. Opcional; padrão 10.
DB_TEST_CONNECT_TIMEOUT=10
